# ── Servidor ──────────────────────────────────────────────────────────────────
# example: 3001
PORT=
# example: development
NODE_ENV=
# example: mongodb://localhost:27017/caixinha
MONGODB_URI=
# example: http://localhost:5173
CORS_ORIGIN=
# example: http://localhost:3001
VITE_API_URL=

# ── Autenticação ──────────────────────────────────────────────────────────────
# segredo usado para assinar os JWTs (gere com: openssl rand -hex 32)
JWT_SECRET=
# example: 8h
JWT_EXPIRES_IN=
